# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Stream ─────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Register a webhook in the Cloudflare dashboard (Stream > Webhooks) pointing
# to https://<your-domain>/api/webhooks/cloudflare and paste its secret here.
CF_STREAM_WEBHOOK_SECRET=
# Found in the Cloudflare dashboard under Stream > your customer subdomain
# (the part before ".cloudflarestream.com").
NEXT_PUBLIC_CF_CUSTOMER_SUBDOMAIN=

# ── AI pipeline ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ── Payments (Instructionals checkout) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Client-side Razorpay Checkout needs the key id too — safe to expose, it's
# the public half of the pair (RAZORPAY_KEY_SECRET stays server-only).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Register a webhook in the Razorpay dashboard (Settings > Webhooks) for
# payment.captured / payment.failed pointing to
# https://<your-domain>/api/webhooks/razorpay and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Stream ─────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Register a webhook in the Cloudflare dashboard (Stream > Webhooks) pointing
# to https://<your-domain>/api/webhooks/cloudflare and paste its secret here.
CF_STREAM_WEBHOOK_SECRET=
# Found in the Cloudflare dashboard under Stream > your customer subdomain
# (the part before ".cloudflarestream.com").
NEXT_PUBLIC_CF_CUSTOMER_SUBDOMAIN=
# Optional but recommended — protects /api/cron/reap-stale-sessions from
# being called by anyone but Vercel Cron. Set the same value in Vercel's
# project env vars; Vercel automatically sends it as a Bearer token on cron
# requests when this is configured. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ── AI pipeline ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ── Payments (Instructionals checkout) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Client-side Razorpay Checkout needs the key id too — safe to expose, it's
# the public half of the pair (RAZORPAY_KEY_SECRET stays server-only).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Register a webhook in the Razorpay dashboard (Settings > Webhooks) for
# payment.captured / payment.failed pointing to
# https://<your-domain>/api/webhooks/razorpay and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=

# ── Error tracking (Sentry) ────────────────────────────────────────────────
# DSN is safe to expose client-side — it's a write-only ingest address, not
# a secret. Get it from sentry.io > your project > Settings > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed to upload de-minified source maps at build time.
# Without these, errors still report, just with minified stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
